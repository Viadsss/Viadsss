{
    // Zed settings
    //
    // For information on how to configure Zed, see the Zed//zed.dev/docs/configuring-zed
    //
    // To see all of Zed's default settings without changing your
    // custom settings, run `zed: open default settings` from the
    // command palette (cmd-shift-p / ctrl-shift-p)
    "proxy": "",
    "zoomed_padding": true,
    "centered_layout": {
        "right_padding": null,
        "left_padding": null
    },
    "focus_follows_mouse": {
        "enabled": false
    },
    "bottom_dock_layout": "left_aligned",
    "tabs": {
        "close_position": "right",
        "file_icons": true,
        "git_status": true
    },
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": true,
        "show_tab_bar_buttons": true,
        "show_nav_history_buttons": true,
        "show": true
    },
    "outline_panel": {
        "button": true
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "agent": {
        "dock": "left",
        "favorite_models": [],
        "model_parameters": []
    },
    "git_panel": {
        "show_count_badge": false,
        "file_icons": true,
        "tree_view": true,
        "collapse_untracked_diff": false,
        "dock": "right"
    },
    "title_bar": {
        "show_menus": false,
        "show_user_menu": true,
        "show_sign_in": true,
        "show_onboarding_banner": true,
        "show_project_items": true,
        "show_branch_name": true,
        "show_branch_status_icon": true
    },
    "debugger": {
        "button": true
    },
    "search": {
        "button": true
    },
    "terminal": {
        "show_count_badge": false,
        "button": true
    },
    "status_bar": {
        "show_active_file": true,
        "line_endings_button": true,
        "cursor_position_button": true,
        "active_language_button": true
    },
    "project_panel": {
        "hide_hidden": false,
        "hide_root": true,
        "indent_guides": {
            "show": "never"
        },
        "git_status_indicator": true,
        "diagnostic_badges": true,
        "bold_folder_labels": true,
        "git_status": true,
        "folder_icons": true,
        "file_icons": true,
        "hide_gitignore": false,
        "dock": "right",
        "button": true
    },
    "cursor_shape": "bar",
    "diagnostics": {
        "inline": {
            "enabled": true
        }
    },
    "toolbar": {
        "breadcrumbs": true
    },
    "auto_signature_help": false,
    "which_key": {
        "enabled": null
    },
    "minimap": {
        "show": "never"
    },
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "ui_font_size": 14.0,
    "ui_font_family": "GeistMono Nerd Font",
    "buffer_line_height": "comfortable",
    "buffer_font_size": 13.0,
    "icon_theme": {
        "mode": "light",
        "light": "Catppuccin Mocha",
        "dark": "Catppuccin Mocha"
    },
    "buffer_font_family": "GeistMono Nerd Font",
    "wsl_connections": [
        {
            "distro_name": "Ubuntu",
            "user": null,
            "projects": [
                {
                    "paths": ["/home/viado07"]
                }
            ]
        }
    ],
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Catppuccin Mocha"
    },
    "cli_default_open_behavior": "existing_window"
}
